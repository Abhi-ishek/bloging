<nav class="navbar navbar-expand-lg navbar-dark sticky-top py-3">
  <div class="container">
    <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" href="/">
      <div class="bg-primary rounded-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: var(--accent-gradient) !important;">
        <i class="bi bi-feather text-white fs-6"></i>
      </div>
      <span class="text-white">Blog<span class="text-gradient">ify</span></span>
    </a>

    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-center gap-3">
        <li class="nav-item">
          <a class="nav-link px-3" href="/">Home</a>
        </li>

        <% if (locals.user) { %>
          <li class="nav-item">
            <a class="nav-link px-3" href="/blog/add-new">
              <i class="bi bi-plus-circle me-1"></i> Add Blog
            </a>
          </li>

          <li class="nav-item dropdown ms-lg-2">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 bg-white bg-opacity-10 rounded-pill px-3 py-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <img src="<%= locals.user.profileImageURL || 'https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y' %>" alt="Profile" class="rounded-circle" style="width: 24px; height: 24px; object-fit: cover;">
              <span class="small fw-semibold"><%= locals.user.fullName %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark border-0 shadow-lg mt-2 p-2" style="background: var(--secondary-bg); border: 1px solid var(--glass-border) !important; border-radius: 12px;">
              <li><a class="dropdown-item rounded-2 py-2" href="/user/profile"><i class="bi bi-person me-2"></i> Profile</a></li>
              <li><hr class="dropdown-divider bg-white bg-opacity-10"></li>
              <li><a class="dropdown-item rounded-2 py-2 text-danger" href="/user/logout"><i class="bi bi-box-arrow-right me-2"></i> Log Out</a></li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link px-3" href="/user/signin">Sign In</a>
          </li>
          <li class="nav-item ms-lg-2">
            <a class="btn btn-premium px-4 py-2" href="/user/signup">Get Started</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<% if (locals.error) { %>
  <div class="container mt-4">
    <div class="alert alert-danger glass-card border-danger border-opacity-25" role="alert" style="background: rgba(220, 53, 69, 0.05); color: #fca5a5;">
      <i class="bi bi-exclamation-circle me-2"></i> <%= locals.error %>
    </div>
  </div>
<% } %>

<% if (locals.success) { %>
  <div class="container mt-4">
    <div class="alert alert-success glass-card border-success border-opacity-25" role="alert" style="background: rgba(25, 135, 84, 0.05); color: #86efac;">
      <i class="bi bi-check-circle me-2"></i> <%= locals.success %>
    </div>
  </div>
<% } %>