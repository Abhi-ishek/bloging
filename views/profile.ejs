<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title>Profile - <%= user.fullName %></title>
    <style>
        .profile-hero {
            background: linear-gradient(180deg, rgba(99, 102, 241, 0.1) 0%, transparent 100%);
            padding: 100px 0 160px;
            position: relative;
        }
        .avatar-wrapper {
            position: relative;
            display: inline-block;
        }
        .avatar-wrapper::after {
            content: '';
            position: absolute;
            inset: -4px;
            background: var(--accent-gradient);
            border-radius: 50%;
            z-index: -1;
            opacity: 0.5;
        }
        .profile-img {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--primary-bg);
        }
        .profile-nav-link {
            padding: 1rem 1.5rem;
            color: var(--text-muted);
            font-weight: 600;
            border-bottom: 2px solid transparent;
            transition: all 0.3s ease;
        }
        .profile-nav-link.active {
            color: var(--text-main);
            border-bottom-color: var(--accent-color);
        }
        .profile-nav-link:hover:not(.active) {
            color: var(--text-main);
            background: var(--glass-bg);
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="profile-hero text-center">
        <div class="container position-relative z-1">
            <div class="avatar-wrapper mb-4">
                <img src="<%= user.profileImageURL %>" alt="<%= user.fullName %>" class="profile-img shadow-lg">
                <div class="position-absolute bottom-0 end-0 bg-success rounded-circle border border-4 border-dark" style="width: 20px; height: 20px;"></div>
            </div>
            <h1 class="display-5 fw-bold mb-2"><%= user.fullName %></h1>
            <div class="d-flex align-items-center justify-content-center gap-2 mb-4">
                <span class="badge rounded-pill bg-white bg-opacity-10 text-white px-3 py-2 border border-white border-opacity-10">
                    <i class="bi bi-shield-check text-primary me-1"></i> <%= user.role || 'Member' %>
                </span>
                <span class="badge rounded-pill bg-white bg-opacity-10 text-white px-3 py-2 border border-white border-opacity-10">
                    <i class="bi bi-envelope me-1"></i> <%= user.email %>
                </span>
            </div>
            <button class="btn btn-outline-premium px-4"><i class="bi bi-gear me-2"></i>Edit Settings</button>
        </div>
    </div>

    <div class="container" style="margin-top: -80px;">
        <div class="row justify-content-center">
            <div class="col-lg-11">
                <div class="glass-card mb-5">
                    <div class="d-flex border-bottom border-white border-opacity-10 p-2">
                        <button class="btn profile-nav-link active rounded-3 border-0" id="posts-tab" data-bs-toggle="pill" data-bs-target="#posts">
                            <i class="bi bi-grid-3x3-gap me-2"></i> My Posts
                        </button>
                        <button class="btn profile-nav-link rounded-3 border-0" id="saved-tab" data-bs-toggle="pill" data-bs-target="#saved">
                            <i class="bi bi-bookmark-heart me-2"></i> Saved Stories
                        </button>
                    </div>

                    <div class="tab-content p-4 p-md-5">
                        <!-- My Posts -->
                        <div class="tab-pane fade show active" id="posts">
                            <div class="row g-4">
                                <% if (blogs && blogs.length > 0) { %>
                                    <% blogs.forEach(blog => { %>
                                        <div class="col-md-6 col-lg-4">
                                            <div class="glass-card h-100 overflow-hidden d-flex flex-column border-0" style="background: rgba(255,255,255,0.02);">
                                                <div class="position-relative" style="height: 180px;">
                                                    <img src="<%= blog.coverImageURL || 'https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?q=80&w=2072&auto=format&fit=crop' %>" 
                                                         class="w-100 h-100 object-fit-cover rounded-top-4" alt="Blog Thumb">
                                                </div>
                                                <div class="p-3">
                                                    <h5 class="fw-bold mb-2 line-clamp-2">
                                                        <a href="/blog/<%= blog._id %>" class="text-white"><%= blog.title %></a>
                                                    </h5>
                                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                                        <span class="text-muted small"><%= new Date(blog.createdAt).toLocaleDateString() %></span>
                                                        <div class="d-flex gap-2">
                                                            <a href="/blog/edit/<%= blog._id %>" class="btn btn-sm btn-outline-light border-0 bg-white bg-opacity-5"><i class="bi bi-pencil"></i></a>
                                                            <a href="/blog/delete/<%= blog._id %>" class="btn btn-sm btn-outline-danger border-0 bg-danger bg-opacity-5"><i class="bi bi-trash"></i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="col-12 py-5 text-center">
                                        <div class="opacity-25 mb-3"><i class="bi bi-journals display-1"></i></div>
                                        <h5 class="fw-bold">No posts yet</h5>
                                        <p class="text-muted small">You haven't written any stories yet.</p>
                                        <a href="/blog/add-new" class="btn btn-premium mt-2">Write First Post</a>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Saved Stories -->
                        <div class="tab-pane fade" id="saved">
                            <div class="row g-4">
                                <% if (locals.savedBlogs && savedBlogs.length > 0) { %>
                                    <% savedBlogs.forEach(blog => { %>
                                        <div class="col-md-6 col-lg-4">
                                            <!-- Similar card structure as above -->
                                            <div class="glass-card h-100 overflow-hidden d-flex flex-column border-0" style="background: rgba(255,255,255,0.02);">
                                                <div class="position-relative" style="height: 180px;">
                                                    <img src="<%= blog.coverImageURL || 'https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?q=80&w=2072&auto=format&fit=crop' %>" 
                                                         class="w-100 h-100 object-fit-cover rounded-top-4" alt="Blog Thumb">
                                                </div>
                                                <div class="p-3">
                                                    <h5 class="fw-bold mb-2 line-clamp-2">
                                                        <a href="/blog/<%= blog._id %>" class="text-white"><%= blog.title %></a>
                                                    </h5>
                                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                                        <span class="text-muted small">Saved on <%= new Date(blog.createdAt).toLocaleDateString() %></span>
                                                        <button class="btn btn-sm btn-outline-danger border-0 bg-danger bg-opacity-5"><i class="bi bi-bookmark-x"></i></button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="col-12 py-5 text-center">
                                        <div class="opacity-25 mb-3"><i class="bi bi-bookmark-heart display-1"></i></div>
                                        <h5 class="fw-bold">No saved stories</h5>
                                        <p class="text-muted small">Found something interesting? Bookmark it to read later.</p>
                                        <a href="/" class="btn btn-outline-premium mt-2">Explore Blogs</a>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/scripts') %>
    <style>
        .object-fit-cover { object-fit: cover; }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;  
            overflow: hidden;
        }
    </style>
</body>
</html>